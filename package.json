{
  "name": "truthpass-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "真验 Zhenyan: service reliability and public reputation layer for white-label commerce Agents.",
  "bin": {
    "truthpass": "bin/truthpass.mjs"
  },
  "scripts": {
    "demo": "tsx src/demo.ts",
    "truthpass": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run typecheck",
    "testbench:tools": "tsx src/tools/testbench-server.ts",
    "api": "tsx api-server.ts",
    "dev": "vite",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "preview": "vite preview",
    "web": "node server.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
