{
  "name": "truthpass-service",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "真验 Zhenyan: service reliability and public reputation layer for white-label commerce Agents.",
  "bin": {
    "truthpass": "bin/truthpass.mjs"
  },
  "scripts": {
    "demo": "tsx src/demo.ts",
    "truthpass": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy:bot-chain": "node scripts/deploy-bot-chain.mjs",
    "grant:bot-chain-roles": "node scripts/grant-bot-chain-roles.mjs",
    "deploy:bot-chain-mainnet": "node --env-file-if-exists=.env.local scripts/deploy-bot-chain-mainnet.mjs",
    "deploy:consumer-gateway-mainnet": "node --env-file-if-exists=.env.local scripts/deploy-consumer-gateway-mainnet.mjs",
    "deploy:audit-escrow-mainnet": "node --env-file-if-exists=.env.local scripts/deploy-audit-escrow-mainnet.mjs",
    "grant:audit-escrow-mainnet-roles": "node --env-file-if-exists=.env.local scripts/grant-audit-escrow-mainnet-roles.mjs",
    "grant:bot-chain-mainnet-roles": "node --env-file-if-exists=.env.local scripts/grant-bot-chain-mainnet-roles.mjs",
    "replay:bot-chain-mainnet": "node --env-file-if-exists=.env.local scripts/replay-bot-chain-mainnet.mjs",
    "protocol:server": "tsx src/protocol-server.ts",
    "relayer:server": "tsx src/relayer-server.ts",
    "web:server": "tsx src/web-server.ts",
    "replay:bot-chain": "node scripts/replay-bot-chain.mjs",
    "demo:real-sourced": "tsx src/real-sourced-demo.ts",
    "demo:fish-oil-e2e": "tsx src/fish-oil-order-to-delivery-demo.ts",
    "simulate:sensor-protocol": "node scripts/simulate-sensor-protocol.mjs",
    "start": "npm run build && node --env-file-if-exists=.env --import=tsx api-server.ts",
    "verify": "npm test && npm run typecheck",
    "testbench:tools": "node --env-file-if-exists=.env --import=tsx src/tools/testbench-server.ts",
    "api": "node --env-file-if-exists=.env --import=tsx api-server.ts",
    "dev": "vite",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build && node scripts/verify-web-build.mjs",
    "preview": "vite preview",
    "web": "node --env-file-if-exists=.env --import=tsx api-server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "solc": "0.8.24",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "https-proxy-agent": "^7.0.6",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.59.16",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  }
}
