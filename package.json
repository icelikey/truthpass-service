{
  "name": "truthpass-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "真验 Zhenyan: service reliability and public reputation layer for white-label commerce Agents.",
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env --import=tsx api-server.ts",
    "demo": "node --env-file-if-exists=.env --import=tsx src/demo.ts",
    "test": "node --env-file-if-exists=.env --import=tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run typecheck",
    "testbench:tools": "node --env-file-if-exists=.env --import=tsx src/tools/testbench-server.ts",
    "api": "node --env-file-if-exists=.env --import=tsx api-server.ts",
    "dev": "vite",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "preview": "vite preview",
    "web": "node --env-file-if-exists=.env --import=tsx server.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.59.16",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
