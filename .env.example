# 复制本文件为 .env 并填入真实值；不要把 .env 提交到 git。

# Agent 对话（DeepSeek 官方）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 图片生成（linoroute 中转，可选）
LINOROUTE_API_KEY=
LINOROUTE_BASE_URL=https://linoroute.com/v1
LINOROUTE_MODEL=gpt-image-2

# 反馈邮件（可选，未配置则跳过发信）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FEEDBACK_EMAIL=

# TypeSafe JEV 结构化判别（可选）
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
