# Local-only provider configuration. Never commit .env.local or real keys.
TRUTHPASS_LIVE_API=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=

# Agent-compatible provider used by the server-side contract layer.
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_MODEL=

# Optional protected Agent Gateway and persistent registration controls.
# Leave empty only for demo/synthetic local mode.
TRUTHPASS_AGENT_GATEWAY_TOKEN=
TRUTHPASS_AGENT_REGISTRATION_TOKEN=
TRUTHPASS_AGENT_DATA_CLASS=demo/synthetic

# TypeSafe/JEV provider. Live mode is enabled only when the key and endpoint
# are present and the structured response passes local validation.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
TYPESAFE_MODEL=

# BOT Chain Mainnet deployment. Keep real values in a secret store or .env.local.
TRUTHPASS_MAINNET_RPC_URL=https://rpc.botchain.ai
# Optional local-only proxy for Node RPC calls on Windows; leave empty on a direct server.
TRUTHPASS_HTTPS_PROXY=
TRUTHPASS_EXPECTED_CHAIN_ID=677
TRUTHPASS_DEPLOYER_ADDRESS=
TRUTHPASS_DEPLOYER_PRIVATE_KEY=
TRUTHPASS_DEPLOY_CONFIRM=
TRUTHPASS_ROLE_CONFIRM=
TRUTHPASS_CONTRACT_ADDRESS=
TRUTHPASS_CONSUMER_GATEWAY_ADDRESS=
TRUTHPASS_GATEWAY_DEPLOY_CONFIRM=
TRUTHPASS_AUDIT_ESCROW_ADDRESS=
TRUTHPASS_AUDIT_ESCROW_DEPLOY_CONFIRM=
TRUTHPASS_AUDIT_TREASURY_ADDRESS=
TRUTHPASS_AUDIT_MIN_STAKE=1000000000000000
TRUTHPASS_ROLE_EVIDENCE_WRITER_ROLE=
TRUTHPASS_ROLE_VERIFIER_ROLE=
TRUTHPASS_ROLE_PURCHASE_WRITER_ROLE=
TRUTHPASS_ROLE_CONTRIBUTION_WRITER_ROLE=
TRUTHPASS_ROLE_DISPUTE_ROLE=
TRUTHPASS_ROLE_REVOKER_ROLE=

# Optional persistence and browser-side Supabase configuration.
DATABASE_URL=
DATA_BACKEND=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
