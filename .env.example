# 复制本文件为 .env 并填入真实值；不要把 .env 提交到 git。

# Agent 对话（StepFun）
# Keep the real key only in local .env; never commit it.
AGENT_API_KEY=
AGENT_BASE_URL=https://api.stepfun.com/step_plan/v1
AGENT_MODEL=step-3.7-flash

# 图片生成（linoroute 中转，可选）
LINOROUTE_API_KEY=
LINOROUTE_BASE_URL=https://linoroute.com/v1
LINOROUTE_MODEL=gpt-image-2

# 反馈邮件（可选，未配置则跳过发信）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FEEDBACK_EMAIL=

# TypeSafe JEV 结构化判别（可选）
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

